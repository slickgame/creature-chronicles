{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/data/balance/breedingBalancePresets": ["./src/data/balance/breedingBalancePresetsLive"],
      "@/data/balance/breedingEconomySimulation": ["./src/data/balance/breedingEconomySimulationNormalized"],
      "@/data/battleEngine": ["./src/data/battleEnginePersistent"],
      "@/data/battleMoves": ["./src/data/battleMovesC3"],
      "@/data/battleOutfitter": ["./src/data/battleOutfitterC3"],
      "@/data/battleOutfitterIntegration": ["./src/data/battleOutfitterIntegrationC3"],
      "@/data/battleProfiles": ["./src/data/battleProfilesExpanded"],
      "@/data/breeding": ["./src/data/breedingTutorial"],
      "@/data/breedingRecords": ["./src/data/breedingRecordsSafe"],
      "@/data/chapterOneGuidedTutorial": ["./src/data/chapterOneGuidedTutorialBattle"],
      "@/data/chapterOneStory": ["./src/data/chapterOneStoryGuided"],
      "@/data/coliseumC4": ["./src/data/coliseumC4Hardened"],
      "@/data/nursery": ["./src/data/nurseryMoveInheritanceLifecycle"],
      "@/data/ranchJobs": ["./src/data/ranchJobsPredator"],
      "@/features/battle-outfitter/BattleOutfitterScreenActive": ["./src/features/battle-outfitter/BattleOutfitterScreenTutorial"],
      "@/features/breeding/BreedingFocusedScreen": ["./src/features/breeding/BreedingFocusedScreenTutorial"],
      "@/features/breeding/BreedingScreen": ["./src/features/breeding/BreedingScreenManaged"],
      "@/features/collection/CollectionScreen": ["./src/features/collection/CollectionScreenLedger"],
      "@/features/coliseum/ColiseumC2Screen": ["./src/features/coliseum/ColiseumC2ScreenTutorial"],
      "@/features/coliseum/ColiseumProgressionScreen": ["./src/features/coliseum/ColiseumProgressionShellC4Active"],
      "@/features/guild/GuildHallScreen": ["./src/features/guild/GuildHallScreenTutorial"],
      "@/features/habitats/HabitatScreen": ["./src/features/habitats/HabitatScreenManaged"],
      "@/features/inventory/PlayerInventoryMenu": ["./src/features/inventory/PlayerInventoryMenuTutorial"],
      "@/features/nursery/NurseryScreen": ["./src/features/nursery/NurseryScreenMoves"],
      "@/features/ranch/RanchHubScreen": ["./src/features/ranch/RanchHubScreenTutorial"],
      "@/features/ranch-jobs/RanchJobsScreen": ["./src/features/ranch-jobs/RanchJobsScreenTutorial"],
      "@/features/ranch-office/RanchOfficeScreen": ["./src/features/ranch-office/RanchOfficeScreenLedger"],
      "@/features/town/TownScreen": ["./src/features/town/TownScreenC4"],
      "@/lib/save/localSave": ["./src/lib/save/localSaveLifecycle"],
      "@/lib/save/saveReliability": ["./src/lib/save/saveReliabilityRanchDay"],
      "@/state/GameProvider": ["./src/state/GameProviderC4"],
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/features/battle/BattleArenaScreenOutfitter.tsx",
    "src/features/coliseum/ColiseumC2Screen.tsx"
  ]
}
