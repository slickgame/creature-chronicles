{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/data/breedingRecords": ["./src/data/breedingRecordsSafe"],
      "@/data/nursery": ["./src/data/nurseryGeneticsLifecycle"],
      "@/features/breeding/BreedingFocusedScreen": ["./src/features/breeding/BreedingFocusedScreenLedger"],
      "@/features/breeding/BreedingScreen": ["./src/features/breeding/BreedingScreenManaged"],
      "@/features/collection/CollectionScreen": ["./src/features/collection/CollectionScreenPolished"],
      "@/features/habitats/HabitatScreen": ["./src/features/habitats/HabitatScreenManaged"],
      "@/features/inventory/PlayerInventoryMenu": ["./src/features/inventory/PlayerInventoryMenuManaged"],
      "@/lib/save/localSave": ["./src/lib/save/localSaveLifecycle"],
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
